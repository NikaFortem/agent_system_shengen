# Скопируйте в .env и заполните. .env в git не попадает.
GIGACHAT_AUTH_KEY=        # Authorization key из личного кабинета GigaChat API (base64 client_id:secret)
OPENAI_API_KEY=           # для provider: openai (или OpenRouter и т.п. с base_url)
